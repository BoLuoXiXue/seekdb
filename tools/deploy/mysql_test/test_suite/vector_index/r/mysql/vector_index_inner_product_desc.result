DROP DATABASE IF EXISTS vector_index_ip_desc;
CREATE DATABASE vector_index_ip_desc;
USE vector_index_ip_desc;
SET ob_query_timeout = 20000000;
SET ob_hnsw_ef_search = 100;
CREATE TABLE ip (id INT PRIMARY KEY, tag INT, v VECTOR(3),
VECTOR INDEX idx(v) WITH (distance=inner_product,type=hnsw,lib=vsag));
INSERT INTO ip VALUES (1,1,'[3,1,0]'),(2,1,'[2,0,0]'),
(3,1,'[1,2,0]'),(4,2,'[-1,0,0]'),(5,2,'[0,1,0]');
# ANN plan, with positive scores preserved through a SELECT alias
EXPLAIN BASIC SELECT id, inner_product(v,'[1,0,0]') AS score
FROM ip ORDER BY score DESC APPROXIMATE LIMIT 3;
Query Plan
==============================
|ID|OPERATOR         |NAME   |
------------------------------
|0 |VECTOR INDEX SCAN|ip(idx)|
==============================
Outputs & filters:
-------------------------------------
  0 - output([ip.id], [inner_product(ip.v, cast('[1,0,0]', ARRAY(18, -1)))]), filter(nil), rowset=16
      access([ip.id], [ip.v]), partitions(p0)
      is_index_back=true, is_global_index=false,
      range_key([ip.__vid], [ip.__type]), range(MIN,MIN ; MAX,MAX)always true
SELECT id, inner_product(v,'[1,0,0]') AS score
FROM ip ORDER BY score DESC APPROXIMATE LIMIT 3;
id	score
1	3
2	2
3	1
SELECT id, inner_product(v,'[1,0,0]') AS score
FROM ip ORDER BY negative_inner_product(v,'[1,0,0]') ASC APPROXIMATE LIMIT 3;
id	score
1	3
2	2
3	1
# Direct expression, ordinal, reversed arguments and composed scores
SELECT id FROM ip ORDER BY inner_product(v,'[1,0,0]') DESC APPROXIMATE LIMIT 3;
id
1
2
3
SELECT id, inner_product(v,'[1,0,0]') AS score
FROM ip ORDER BY 2 DESC APPROXIMATE LIMIT 3;
id	score
1	3
2	2
3	1
SELECT id, inner_product('[1,0,0]',v) AS score
FROM ip ORDER BY score DESC APPROXIMATE LIMIT 3;
id	score
1	3
2	2
3	1
SELECT id, inner_product(v,'[1,0,0]') + 10 AS shifted_score,
negative_inner_product(v,'[1,0,0]') AS negative_score
FROM ip ORDER BY inner_product(v,'[1,0,0]') DESC APPROXIMATE LIMIT 3;
id	shifted_score	negative_score
1	13	-3
2	12	-2
3	11	-1
# OFFSET, zero limit and filtering
SELECT id, inner_product(v,'[1,0,0]') AS score
FROM ip ORDER BY score DESC APPROXIMATE LIMIT 2 OFFSET 1;
id	score
2	2
3	1
SELECT id FROM ip ORDER BY inner_product(v,'[1,0,0]') DESC APPROXIMATE LIMIT 0;
id
SELECT id, inner_product(v,'[1,0,0]') AS score FROM ip WHERE tag = 2
ORDER BY score DESC APPROXIMATE LIMIT 2;
id	score
5	0
4	-1
# Different parameter values and repeated executions must retain their signs
PREPARE ps FROM 'SELECT id, inner_product(v,?) AS score FROM ip ORDER BY score DESC APPROXIMATE LIMIT 3';
SET @q = NULL;
EXECUTE ps USING @q;
id	score
#	NULL
#	NULL
#	NULL
SET @q = '[1,0,0]';
EXECUTE ps USING @q;
id	score
1	3
2	2
3	1
EXECUTE ps USING @q;
id	score
1	3
2	2
3	1
SET @q = '[-1,0,0]';
EXECUTE ps USING @q;
id	score
4	1
5	0
3	-1
SET @q = '[1,1,0]';
EXECUTE ps USING @q;
id	score
1	4
3	3
2	2
SET @q = NULL;
EXECUTE ps USING @q;
id	score
#	NULL
#	NULL
#	NULL
DEALLOCATE PREPARE ps;
SELECT inner_product(v,NULL) AS score FROM ip ORDER BY score DESC APPROXIMATE LIMIT 3;
score
NULL
NULL
NULL
# Exact DESC and positive ASC retain their original behavior
SELECT id, inner_product(v,'[1,0,0]') AS score FROM ip ORDER BY score DESC LIMIT 3;
id	score
1	3
2	2
3	1
SELECT id, inner_product(v,'[1,0,0]') AS score
FROM ip ORDER BY score ASC APPROXIMATE LIMIT 3;
id	score
4	-1
5	0
3	1
# No compatible index: exact fallback keeps positive scores and NULL placement
CREATE TABLE plain (id INT PRIMARY KEY, v VECTOR(3));
INSERT INTO plain SELECT id,v FROM ip;
INSERT INTO plain VALUES (6,NULL);
SELECT id, inner_product(v,'[1,0,0]') AS score
FROM plain ORDER BY score DESC APPROXIMATE LIMIT 10;
id	score
1	3
2	2
3	1
5	0
4	-1
6	NULL
CREATE TABLE l2 (id INT PRIMARY KEY, v VECTOR(3),
VECTOR INDEX idx(v) WITH (distance=l2,type=hnsw,lib=vsag));
INSERT INTO l2 SELECT id,v FROM ip;
SELECT id, inner_product(v,'[1,0,0]') AS score
FROM l2 ORDER BY score DESC APPROXIMATE LIMIT 3;
id	score
1	3
2	2
3	1
# Nullable index column: finite scores must still sort descending
INSERT INTO ip VALUES (6,2,NULL);
SELECT id, inner_product(v,'[1,0,0]') AS score
FROM ip ORDER BY score DESC APPROXIMATE LIMIT 3;
id	score
1	3
2	2
3	1
# Ties have no defined ID order; return every tied row and sort for comparison
INSERT INTO ip VALUES (7,1,'[3,-1,0]');
SELECT id, inner_product(v,'[1,0,0]') AS score
FROM ip ORDER BY score DESC APPROXIMATE LIMIT 2;
id	score
1	3
7	3
USE test;
DROP DATABASE vector_index_ip_desc;
